{
  "name": "claude-code-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "由 OMP 执行工具、Claude Code 提供推理的本地模型适配器（实验版）",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node model-gateway/server.mjs",
    "import:omp": "node model-gateway/import-omp.mjs",
    "test": "node --test model-gateway/*.test.mjs",
    "test:engine": "node model-gateway/engine-check.mjs",
    "test:omp": "node model-gateway/omp-check.mjs",
    "test:e2e": "node model-gateway/engine-check.mjs --omp"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.277",
    "js-yaml": "3.15.2"
  }
}
