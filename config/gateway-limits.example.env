# 网关运行参数示例；本文件不会自动加载，安装器或 systemd EnvironmentFile 需显式引用。
# 对照 Sub2API b0a02a3304a0a78cdd003ddda1dd23ba02c03084；相同数字不代表相同计时层。

# 推理：有进展时默认不设整轮截止；无进展超时仍为 180 秒，任一值设为 0 可关闭。
GATEWAY_TIMEOUT_MS=0
GATEWAY_IDLE_TIMEOUT_MS=180000

# 工具数量和累计 CLI 协议输出默认不另设硬限额；仍受请求体和系统内存预算约束。
GATEWAY_MAX_TOOLS=0
GATEWAY_MAX_CLI_OUTPUT_BYTES=0

# 本例适用于现有小内存模板；大载荷模式可将单请求与在场总量一起提高到 268435456。
# 256 MiB 是允许配置的单请求上限；提高前需同步规划 systemd MemoryMax 和并发。
GATEWAY_MAX_REQUEST_BYTES=33554432
GATEWAY_MAX_INFLIGHT_BYTES=67108864
GATEWAY_MAX_IMAGE_BYTES=5242880

# MCP 请求上限未指定时跟随单请求体上限，不再固定为 4 MiB。
# GATEWAY_MAX_MCP_REQUEST_BYTES=33554432

# 单用户默认三路并发、八个等待项；机器资源不足时降低并发，队列不替代内存预算。
GATEWAY_MAX_CONCURRENT=3
GATEWAY_MAX_QUEUED=8

# 输出接受上限，仍受真实模型限制；不是每轮必然生成的 token 数。
# Chat Completions 缺省 8192；Messages 缺省为 128000 与本部署上限的较小值。
GATEWAY_MAX_OUTPUT_TOKENS=128000

# 仅控制网关自身缓存断点；5m 与 Sub2API 自建断点默认值一致。
GATEWAY_CACHE_BREAKPOINT=5m
