[Unit]
Description=Verify and update official Claude CLI for relay
After=network-online.target velella-model-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/claude-relay/update-cli.py
TimeoutStartSec=30min
UMask=0022
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /usr/local/lib/claude-relay /usr/local/share/claude-relay /home/harness/model-gateway
MemoryMax=512M
LogNamespace=claude-relay
