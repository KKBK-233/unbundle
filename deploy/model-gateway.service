[Unit]
Description=Velella private Claude model gateway
After=network-online.target

[Service]
Type=simple
User=harness
Group=harness
WorkingDirectory=/home/harness/app
ExecStart=/usr/local/bin/velella-node /home/harness/app/model-gateway/cloud-server.mjs
Environment=PATH=/home/harness/app/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=GATEWAY_CONTEXT_DIAGNOSTICS=1
Environment=GATEWAY_MAX_CONCURRENT=3
# 入站体在排队前已完整驻留内存：单个 32MB 请求峰值约 124MB（分片、拼接缓冲、
# UTF-8 字符串与解析结果同时在场）。队列保持 64 会让最坏驻留远超下方 MemoryMax，
# 因此按字节总量准入，并把队列收窄到与 MemoryMax 相称的深度。
Environment=GATEWAY_MAX_QUEUED=8
Environment=GATEWAY_MAX_REQUEST_BYTES=33554432
Environment=GATEWAY_MAX_IMAGE_BYTES=5242880
Environment=GATEWAY_MAX_INFLIGHT_BYTES=67108864
Environment=GATEWAY_CONTEXT_WINDOW=400000
# 为三路推理保留工作集，同时限制进程组内存并允许有限 Swap。
MemoryHigh=700M
MemoryMax=768M
MemorySwapMax=768M
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/harness/model-gateway /home/harness/state/runtime-home

[Install]
WantedBy=multi-user.target
